{
  "nome": "PainelMunicipios",
  "titulo": "Municípios: PIB por habitante e IDEB",
  "tabela": "Municipios",
  "csv": "../dados/municipios.csv",
  "separador": ",",
  "colunas": {
    "codigo_ibge": "texto",
    "municipio": "texto",
    "uf": "texto",
    "populacao": "inteiro",
    "pib_mil_reais": "inteiro",
    "ideb_anos_iniciais": "decimal",
    "ideb_anos_finais": "decimal"
  },
  "colunas_calculadas": [
    {"nome": "municipio_uf", "dax": "Municipios[municipio] & \" - \" & Municipios[uf]", "tipo": "texto"}
  ],
  "medidas": [
    {"nome": "Municípios", "dax": "COUNTROWS(Municipios)", "formato": "#,0"},
    {"nome": "População", "dax": "SUM(Municipios[populacao])", "formato": "#,0"},
    {"nome": "PIB por habitante (R$)", "dax": "DIVIDE(SUM(Municipios[pib_mil_reais]) * 1000, SUM(Municipios[populacao]))", "formato": "#,0"},
    {"nome": "IDEB anos iniciais", "dax": "AVERAGE(Municipios[ideb_anos_iniciais])", "formato": "0.0"},
    {"nome": "IDEB anos finais", "dax": "AVERAGE(Municipios[ideb_anos_finais])", "formato": "0.0"},
    {"nome": "Sem IDEB anos iniciais", "dax": "COUNTROWS(FILTER(Municipios, ISBLANK(Municipios[ideb_anos_iniciais])))", "formato": "#,0"}
  ],
